# ---------------------------------------------------------------------------
# MEGAPLAST KZ — конфигурация сайта, ИИ-консультанта и приёма заявок
# ---------------------------------------------------------------------------
# Скопируйте файл в .env.local и заполните значениями компании.
# .env.local в .gitignore и никогда не попадает в репозиторий.
# Секреты (ключ Groq, пароль панели) используются ТОЛЬКО на сервере.

# --- Домен ----------------------------------------------------------------
# Нужен для canonical, sitemap, robots и превью в соцсетях.
# На Vercel можно не задавать — подставится домен продакшена автоматически.
NEXT_PUBLIC_SITE_URL=https://example.kz

# --- ИИ-консультант (Groq) ------------------------------------------------
# Ключ: console.groq.com/keys. В клиентский код не попадает.
GROQ_API_KEY=
# Модель: openai/gpt-oss-120b (качество) или openai/gpt-oss-20b (скорость)
GROQ_MODEL=openai/gpt-oss-120b

# --- Панель менеджера: /admin --------------------------------------------
# Пароль для входа и секрет для подписи сессии (случайная строка).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Уведомления менеджеру ------------------------------------------------
# Вариант 1: Telegram. Токен от @BotFather + chat_id получателя заявок.
# В Telegram уходят текст заявки и фотографии объекта.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Вариант 2: универсальный вебхук (CRM, Bitrix24, amoCRM, Make/n8n).
# POST JSON: { id, name, phone, product, size, qty, system, color, mesh,
#             preferredDate, comment, message, aiSummary, photos, source }
LEAD_WEBHOOK_URL=

# --- База заявок ----------------------------------------------------------
# Без DATABASE_URL заявки пишутся в файл .data/leads.json — это работает
# локально и на обычном Node-сервере. НА VERCEL файлы не сохраняются,
# поэтому для продакшена укажите строку подключения Postgres (Neon, Supabase,
# Vercel Postgres). Таблица создаётся автоматически при первой заявке.
DATABASE_URL=
# Для локального Postgres без TLS: DATABASE_SSL=false
DATABASE_SSL=
# Каталог файловой базы (по умолчанию ./.data)
LEADS_DATA_DIR=
