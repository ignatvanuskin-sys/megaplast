# ---------------------------------------------------------------------------
# MEGAPLAST KZ — конфигурация сайта и приёма заявок
# ---------------------------------------------------------------------------
# Домен сайта: нужен для canonical, sitemap, robots и превью в соцсетях.
# На Vercel можно не задавать — подставится домен продакшена автоматически.
NEXT_PUBLIC_SITE_URL=https://example.kz

# Скопируйте этот файл в .env.local и заполните значениями компании.
# Пока переменная не заполнена, форма НЕ показывает ложное "заявка отправлена":
# вместо этого посетителю предлагается отправить те же данные в WhatsApp.
#
# 1) Универсальный вебхук (CRM, Bitrix24, amoCRM, Make/n8n, собственный endpoint).
#    POST JSON: { name, phone, contactMethod, product, size, qty, objectType, comment, page, ts }
LEAD_WEBHOOK_URL=

# 2) Либо Telegram-бот. Токен от @BotFather и chat_id получателя заявок.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
